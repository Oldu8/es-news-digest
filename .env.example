# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Channel id, e.g. -1001234567890 (see README: getUpdates)
TELEGRAM_CHANNEL_ID=
# Your private chat id with the bot, for error alerts
TELEGRAM_ADMIN_CHAT_ID=
# Optional: log level, e.g. info or es_news_digest=debug
RUST_LOG=info
